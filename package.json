{
  "name": "city-of-vice",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "24.19.0",
    "npm": "11.9.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "format:ocaml": "opam exec -- dune build -j 1 @fmt",
    "format:web": "prettier --check package.json tsconfig.json '*config.ts' 'src/**/*.ts' 'web/**/*.{html,ts}' 'tests/contract/**/*.ts' 'tests/browser/**/*.ts' docs/S02_FOUNDATION.md .github/workflows/verify.yml",
    "format:check": "npm run format:ocaml && npm run format:web",
    "build:native": "opam exec -- dune build -j 1 test/foundation_test.exe",
    "build:melange": "opam exec -- dune build -j 1 @melange",
    "typecheck": "tsc --noEmit",
    "test:prototype": "node --max-old-space-size=128 --test --test-concurrency=1 tests/*.test.cjs",
    "test:native": "opam exec -- dune runtest -j 1",
    "test:contract": "vitest run --config vitest.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test": "npm run test:prototype && npm run test:native && npm run test:contract",
    "build:web": "vite build",
    "verify": "npm run format:check && npm run build:native && npm run build:melange && npm run typecheck && npm test && npm run build:web && npm run test:browser"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "playwright": "1.64.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
