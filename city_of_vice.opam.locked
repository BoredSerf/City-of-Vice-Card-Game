opam-version: "2.0"
name: "city_of_vice"
version: "0.0.0"
synopsis: "Product-neutral City of Vice development foundation"
description:
  "Development-only OCaml and Melange dependencies for the S02 foundation."
homepage: "https://github.com/BoredSerf/City-of-Vice-Card-Game"
depends: [
  "astring" {= "0.8.5"}
  "base" {= "v0.17.3"}
  "base-bigarray" {= "base"}
  "base-domains" {= "base"}
  "base-effects" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "camlp-streams" {= "5.0.1"}
  "cmdliner" {= "2.1.1"}
  "compiler-cloning" {= "enabled"}
  "cppo" {= "1.8.0"}
  "csexp" {= "1.5.2"}
  "dune" {= "3.24.2"}
  "dune-build-info" {= "3.24.2"}
  "dune-configurator" {= "3.24.2"}
  "either" {= "1.0.0"}
  "fix" {= "20250919"}
  "fpath" {= "0.7.3"}
  "melange" {= "7.0.1-55"}
  "menhir" {= "20260209"}
  "menhirCST" {= "20260209"}
  "menhirGLR" {= "20260209"}
  "menhirLib" {= "20260209"}
  "menhirSdk" {= "20260209"}
  "ocaml" {= "5.5.1"}
  "ocaml-base-compiler" {= "5.5.1"}
  "ocaml-compiler" {= "5.5.1"}
  "ocaml-compiler-libs" {= "v0.17.0"}
  "ocaml-options-vanilla" {= "1"}
  "ocaml-version" {= "4.1.5"}
  "ocaml_intrinsics_kernel" {= "v0.17.3"}
  "ocamlbuild" {= "0.16.1"}
  "ocamlfind" {= "1.9.9~preview"}
  "ocamlformat" {= "0.29.0"}
  "ocamlformat-lib" {= "0.29.0"}
  "ocp-indent" {= "1.10.0"}
  "ppx_derivers" {= "1.2.1"}
  "ppxlib" {= "0.39.0"}
  "re" {= "1.14.0"}
  "sexplib0" {= "v0.17.0"}
  "stdio" {= "v0.17.0"}
  "topkg" {= "1.1.1"}
  "uucp" {= "18.0.0"}
  "uuseg" {= "18.0.0"}
  "uutf" {= "1.0.4"}
  "yojson" {= "3.0.0"}
]
build: ["dune" "build" "-j" jobs "@all"]