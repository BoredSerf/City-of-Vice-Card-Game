(executable
 (name setup_parity)
 (modules setup_parity)
 (libraries city_engine native_json)
 (modes native))

(rule
 (targets setup_parity.json)
 (action
  (with-stdout-to
   %{targets}
   (run %{exe:setup_parity.exe}))))

(alias
